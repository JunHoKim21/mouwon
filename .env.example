# HTTP/WebSocket 통합 서버 포트 (기본값: 3001)
PORT=3001

# Vite 개발 서버(/ws 프록시)가 연결할 로컬 백엔드 포트 (기본값: 3001)
WS_PORT=3001

# WebSocket 접속을 허용할 Origin 목록 (쉼표로 구분, 비어 있으면 동일 호스트 또는 개발 환경 허용)
# 예: ALLOWED_ORIGINS=https://example.com,https://www.example.com
ALLOWED_ORIGINS=

# Google Analytics 4 측정 ID (선택 사항, 예: G-XXXXXXXXXX)
VITE_GA_MEASUREMENT_ID=
